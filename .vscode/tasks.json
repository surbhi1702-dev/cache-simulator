{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build --config Debug -j 4",
      "dependsOn": "configure",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "ctest --test-dir build -C Debug --output-on-failure",
      "dependsOn": "build",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "run experiments",
      "type": "shell",
      "command": "python scripts/run_experiments.py",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "dashboard",
      "type": "shell",
      "command": "python -m streamlit run dashboard/app.py",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
